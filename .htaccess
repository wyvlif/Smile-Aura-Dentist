Options -Indexes
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.env|config\.php|config\.local\.php|config\.local\.example\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.env|config\.php|config\.local\.php|config\.local\.example\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
